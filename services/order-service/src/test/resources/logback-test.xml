<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{24} - %msg%n</pattern>
        </encoder>
    </appender>
    <logger name="org.testcontainers" level="WARN"/>
    <logger name="com.github.dockerjava" level="WARN"/>
    <logger name="org.eclipse.jetty" level="WARN"/>
    <logger name="org.apache.kafka" level="WARN"/>
    <logger name="org.hibernate" level="WARN"/>
    <logger name="org.flywaydb" level="INFO"/>
    <!-- Container logs (Testcontainers Slf4jLogConsumer, logger "container.<name>") are written verbatim to
         target/container-logs/<name>.log, separate from the service log; LogScan checks them. append=true: Spring Boot
         re-initialises Logback when the context starts, after the containers have logged their startup;
         the directory is cleared once per run by maven-clean-plugin (pre-integration-test). -->
    <appender name="CONTAINER_POSTGRES" class="ch.qos.logback.core.FileAppender">
        <file>target/container-logs/postgres.log</file>
        <append>true</append>
        <encoder>
            <pattern>%msg%n</pattern>
        </encoder>
    </appender>
    <logger name="container.postgres" level="INFO" additivity="false">
        <appender-ref ref="CONTAINER_POSTGRES"/>
    </logger>
    <appender name="CONTAINER_KAFKA" class="ch.qos.logback.core.FileAppender">
        <file>target/container-logs/kafka.log</file>
        <append>true</append>
        <encoder>
            <pattern>%msg%n</pattern>
        </encoder>
    </appender>
    <logger name="container.kafka" level="INFO" additivity="false">
        <appender-ref ref="CONTAINER_KAFKA"/>
    </logger>
    <root level="INFO">
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>
