{
  "permissions": {
    "allow": [
      "Bash(java .claude/skills/it-gen/scripts/Scope.java:*)",
      "Bash(mvn -pl :*)",
      "Bash(mvn -q -pl :*)",
      "Bash(git diff:*)",
      "Bash(git status:*)",
      "Bash(git merge-base:*)",
      "Bash(git log:*)",
      "Bash(docker ps:*)",
      "Bash(docker info:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect-migrations.sh"
          }
        ]
      }
    ]
  }
}
