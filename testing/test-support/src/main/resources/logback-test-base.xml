<?xml version="1.0" encoding="UTF-8"?>
<!-- Shared test logging for every module on test-support: console output, chatty libraries at WARN (warnings
     and errors still show, so LogScan sees them). Container logs do not go through Logback: test-support's
     ContainerLogs writes them to target/container-logs/<name>.log. A module adds its own loggers with
     <include resource="logback-test-base.xml"/> in its own logback-test.xml. -->
<included>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{24} - %msg%n</pattern>
        </encoder>
    </appender>
    <logger name="org.testcontainers" level="WARN"/>
    <logger name="com.github.dockerjava" level="WARN"/>
    <logger name="org.eclipse.jetty" level="WARN"/>
    <logger name="org.apache.kafka" level="WARN"/>
    <logger name="org.hibernate" level="WARN"/>
    <root level="INFO">
        <appender-ref ref="STDOUT"/>
    </root>
</included>
