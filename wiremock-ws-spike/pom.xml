<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.example.demo</groupId>
        <artifactId>trading-demo-app</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>wiremock-ws-spike</artifactId>
    <name>wiremock-ws-spike</name>
    <description>
        M0 spike (docs/DESIGN.md §9): proves WireMock 4 beta WebSocket mocking works — accept a
        connection, match an inbound frame, and push a server response — before M2+ relies on it
        to mock the exchange price feed. Needs no Docker, so it runs in plain `mvn test`.
    </description>

    <dependencies>
        <dependency>
            <groupId>org.wiremock</groupId>
            <artifactId>wiremock</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.java-websocket</groupId>
            <artifactId>Java-WebSocket</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Shared test stack (JUnit, AssertJ, Awaitility, Logback, Testcontainers, REST-Assured) and test-rules. -->
        <dependency>
            <groupId>com.example.demo</groupId>
            <artifactId>test-support</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
